// Cloudflare Worker config. Sandboxes are not here: the Node runner creates them on Modal.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voluma-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["API_TOKEN"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "voluma", "migrations_dir": "migrations" }]
}
