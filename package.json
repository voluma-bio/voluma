{
  "name": "voluma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @voluma/web dev",
    "check": "biome check . && nx run-many -t typecheck test --outputStyle=static",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "nx run-many -t typecheck --outputStyle=static",
    "test": "nx run-many -t test --outputStyle=static",
    "check:pr-body": "node tools/ci/check-pr-body.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "lefthook": "^2.1.9",
    "nx": "^23.0.1",
    "typescript": "catalog:"
  }
}
