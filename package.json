{
  "name": "voluma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "check": "biome check . && nx run-many -t typecheck test --outputStyle=static",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "nx run-many -t typecheck --outputStyle=static",
    "test": "nx run-many -t test --outputStyle=static",
    "check:pr-body": "node tools/ci/check-pr-body.mjs",
    "prepare": "lefthook install",
    "db:reset": "node tools/dev.mjs reset",
    "db:up": "docker start voluma-pg || docker run -d --name voluma-pg -p 127.0.0.1:54432:5432 -e POSTGRES_USER=voluma -e POSTGRES_PASSWORD=voluma -v voluma-pg-data:/var/lib/postgresql/data postgres:16-alpine"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "lefthook": "^2.1.9",
    "nx": "^23.0.1",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
