# Copy to .env at the repo root (git-ignored) and fill in. Worktrees share the
# primary checkout's file: `ln -s ~/gitrepos/voluma/.env .env`.
# The runner reads it into a config object (apps/runner/src/config.ts), never into
# process.env, so other tools and child processes don't inherit the keys. Set
# VOLUMA_ENV_FILE to read another file. `pnpm dev` reads it too (tools/dev.mjs), and
# starts the API with it as an env file, so the API sees these as it would Railway's
# variables; nothing here is per worktree.

# R2: bucket voluma-staging. R2 > Manage API tokens; the account id is in the
# Cloudflare dashboard URL. Endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voluma-staging

# Cloudflare: R2 edit rights (temporary per-mount credentials are minted from this token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Modal sandboxes. Leave empty to use ~/.modal.toml (`modal token new`).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Agent models (pi-ai), one key per provider. The runner passes the key to pi-ai
# itself. Muse uses Meta's Model API. Claude needs an API key from the Claude
# Console, not a Claude subscription login. The Meta key also pays for the
# `segment_sam` tool (SAM 3.1, about $0.10 per scan; needs ffmpeg on the runner's PATH);
# without it, `voluma` runs do not get that tool. Visitor runs use the visitor's key.
VOLUMA_OPENAI_API_KEY=
VOLUMA_META_API_KEY=
VOLUMA_ANTHROPIC_API_KEY=

# Local Postgres server for `pnpm dev`: it makes a database per worktree on it
# (voluma_<directory name>_<hash>). `pnpm db:up` starts a container; the launcher's
# default matches it. Uncomment to point at another server.
# DATABASE_SERVER_URL=postgres://voluma:voluma@localhost:54432/postgres

# The runner service (`pnpm --filter @voluma/runner start`). RUNNER_MODEL is the worker
# model of runs on our keys, as provider/id (the key is VOLUMA_<PROVIDER>_API_KEY above);
# RUNNER_CHECK_MODEL (default: the worker's) runs the check threads and RUNNER_MAIN_MODEL
# (default meta/muse-wonder-1.0 if VOLUMA_META_API_KEY is set, else the worker's) the run's main thread. Visitor runs use the visitor's Meta
# key with RUNNER_VISITOR_MODEL (the main thread too, unless RUNNER_MAIN_MODEL is a
# Standard-mode Meta model). RUNNER_CONCURRENCY is the runs
# it holds at once. A `-contributor` Meta model (e.g. meta/muse-spark-1.3-contributor) is
# cheaper but lets Meta train on everything sent to it: use it only for test runs with no
# lab data, never on a deployed runner. The API's URL and bearer token are VOLUMA_API_URL and VOLUMA_API_TOKEN;
# unset, it reads the local API's from .dev/env.json, which `pnpm dev` writes. Against a
# deployed API it claims real users' runs, and a visitor's keys with them.

# Optional read-only token for agents debugging runs: `GET /api/run/runs`, `/runs/:id` and
# `/runs/:id/stream` across every lab, nothing else (apps/api/src/domain.ts `requireReader`).
# VOLUMA_DEBUG_TOKEN=
RUNNER_MODEL=
RUNNER_CHECK_MODEL=
RUNNER_MAIN_MODEL=
RUNNER_VISITOR_MODEL=
# Off unless set (a per-deploy choice: lab data leaves Meta's Standard mode). Worker and check
# threads that start while their model is failing start on this one, e.g.
# anthropic/claude-opus-5-5 (key VOLUMA_ANTHROPIC_API_KEY). Never used by visitor runs.
RUNNER_FALLBACK_MODEL=
RUNNER_CONCURRENCY=
# Dollars of spend (all claims, provider gateway calls included) after which a run is stopped and
# ends failed. Sent with each claim: the gateway refuses calls past it. Default 10 (a SAM call reserves $3).
RUNNER_MAX_RUN_COST_USD=

# Sign-in: WorkOS, staging environment. Dashboard > API Keys shows the client id
# (client_...) and the API key (sk_test_...). The cookie password seals the session
# cookie; generate one with `openssl rand -base64 32` (at least 32 characters). The lab
# organization id (org_...) is the Yao Lab organization: its members sign in and see all
# the lab's data. The optional demo organization id is the Demo organization: its members
# sign in too but see only their own records; leave it empty to allow none.
# The API also needs APP_URL, the origin browsers use; `pnpm dev` sets it to Vite's.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_LAB_ORGANIZATION_ID=
WORKOS_JUDGES_ORGANIZATION_ID=
# Optional: let anyone in as a guest of this organization, the Demo one, never the Yao Lab
# (no sign-in screen; Sign in stays in the account menu). GUEST_SCOPE is self (a guest sees only their own runs; use this for the Demo org) or lab (all its data, default). Empty: sign-in wall.
GUEST_ORGANIZATION_ID=
GUEST_SCOPE=
# Run limits per organization (LAB, JUDGES, DEMO = the guest organization): PER_CALLER,
# CONCURRENT, PER_DAY, USD_PER_DAY, VISITOR_ACTIVE. Unset is no limit. Numbers: apps/api/.context/deploy.md.
RUN_LIMITS_LAB_CONCURRENT=4
RUN_LIMITS_JUDGES_CONCURRENT=2
RUN_LIMITS_JUDGES_PER_DAY=50
RUN_LIMITS_DEMO_PER_CALLER=1
RUN_LIMITS_DEMO_CONCURRENT=2
RUN_LIMITS_DEMO_PER_DAY=10
RUN_LIMITS_DEMO_VISITOR_ACTIVE=4

# Railway project token (staging environment only), for operating the deployed API:
# apps/api/.context/deploy.md. Sent as the Project-Access-Token header; the CLI reads it too.
RAILWAY_TOKEN=
