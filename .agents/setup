#!/usr/bin/env bash
# Install the application workspace and optional agent tooling for orb snapshots.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.local/bin:$PATH"
SECONDS=0

printf '\nInstalling application dependencies\n'
pnpm install --frozen-lockfile
printf 'Application dependencies ready after %ss\n' "$SECONDS"

printf '\nInstalling Meridian and its Python runtime\n'
uv tool install --python 3.12 meridian-cli==0.15.0
printf 'Toolchain ready after %ss\n' "$SECONDS"

printf '\nSyncing agent packages from mars.toml\n'
meridian mars sync
printf 'Setup finished after %ss\n' "$SECONDS"
