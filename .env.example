# Copy to .env at the repo root (git-ignored) and fill in. Worktrees share the
# primary checkout's file: `ln -s ~/gitrepos/voluma/.env .env`.
# The runner reads it into a config object (apps/runner/src/config.ts), never into
# process.env, so other tools and child processes don't inherit the keys. Set
# VOLUMA_ENV_FILE to read another file. The Worker reads apps/api/.dev.vars.

# R2: bucket voluma-staging. R2 > Manage API tokens; the account id is in the
# Cloudflare dashboard URL. Endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voluma-staging

# Cloudflare deploys (wrangler reads these): Workers, D1 and R2 edit rights.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Modal sandboxes. Leave empty to use ~/.modal.toml (`modal token new`).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Agent models (pi-ai), one key per provider. The runner passes the key to pi-ai
# itself. Muse uses Meta's Model API. Claude needs an API key from the Claude
# Console, not a Claude subscription login.
VOLUMA_OPENAI_API_KEY=
VOLUMA_META_API_KEY=
VOLUMA_ANTHROPIC_API_KEY=

# Runner to API: where the run domain is, and the bearer token it checks
# (the API's API_TOKEN in apps/api/.dev.vars).
VOLUMA_API_URL=http://localhost:8787
VOLUMA_API_TOKEN=

# Sign-in: WorkOS, staging environment. Dashboard > API Keys shows the client id
# (client_...) and the API key (sk_test_...). The cookie password seals the session
# cookie; generate one with `openssl rand -base64 32` (at least 32 characters).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=

# Postgres. Locally, each worktree uses its own database, never a shared one. On
# Railway the Postgres service provides it.
DATABASE_URL=

# Railway deploys (the railway CLI reads it): a project token, from Project
# settings > Tokens.
RAILWAY_TOKEN=
