{
  "name": "@voluma/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node ../../tools/dev-run.mjs runner tsx src/main.ts",
    "sandboxes:clean": "tsx src/sandboxes-clean.ts",
    "try-run": "node ../../tools/dev-run.mjs try-run tsx src/try-run.ts",
    "dev-sandbox": "tsx src/dev-sandbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@voluma/contracts": "workspace:*",
    "@voluma/harness": "workspace:*",
    "@voluma/object-store": "workspace:*",
    "@voluma/provider-calls": "workspace:*",
    "@voluma/workflow": "workspace:*",
    "modal": "0.11.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
