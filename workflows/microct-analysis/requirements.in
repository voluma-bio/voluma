# The top-level Python dependencies of the micro-CT skills. requirements.txt is compiled from
# this file and is what the sandbox image and the tests install:
#
#   cd workflows/microct-analysis && uv pip compile requirements.in --output-file requirements.txt \
#     --extra-index-url https://wheels.vtk.org --emit-index-url --no-annotate \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_28 --no-emit-package vtk
#
# Install requirements.txt with `--no-deps` (or `uv pip sync`): pyvista depends on the default
# `vtk` wheel, which segfaults without a display and would replace vtk-osmesa, so the compiled
# file leaves vtk out and pins everything else. The vtk index also serves dev builds of
# vtk-osmesa, so keep it pinned; it ships vtk 9.3.1 (imported as `vtk`) and only for
# linux/x86_64 and Windows.
vtk-osmesa==9.3.1
numpy==2.5.4
scipy==1.18.1
scikit-image==0.26.0  # classic_segment.grow calls the private watershed_raveled: re-check it before bumping
pydicom==3.0.2
nibabel==5.4.2
SimpleITK==2.5.6
matplotlib==3.11.2
pyvista==0.49.1
pyvista-validation==0.2.2
